{
  "name": "template-nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.8.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "postcss-custom-media": "12.0.1",
    "postcss-import": "17.0.0",
    "postcss-media-minmax": "5.0.0",
    "postcss-nesting": "14.0.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "build": "node scripts/run-next.mjs build && pnpm run copy:standalone-assets",
    "build:start": "node .next/standalone/server.js",
    "copy:standalone-assets": "node scripts/copy-standalone-assets.mjs",
    "start": "node scripts/run-next.mjs dev",
    "dev": "node scripts/run-next.mjs dev",
    "typegen": "node scripts/run-next.mjs typegen",
    "typecheck": "pnpm typegen && tsc --noEmit --incremental false -p tsconfig.json",
    "lint:baseline": "node scripts/lint/dependency-baseline.mjs",
    "lint:classes": "node tooling/code-style/no-class-syntax.mjs src scripts tooling next.config.ts postcss.config.js",
    "lint:imports": "node tooling/code-style/typescript-import-layout.mjs",
    "lint:objects": "node tooling/code-style/typescript-object-layout.mjs",
    "lint:parameters": "node tooling/code-style/typescript-parameter-layout.mjs",
    "lint:consts": "node tooling/code-style/typescript-const-layout.mjs",
    "lint:css": "node tooling/code-style/css-formatting.mjs",
    "lint:context-md": "node scripts/lint/context-md-prose-unwrap.mjs --check",
    "lint:tooling": "pnpm --dir tooling/code-style lint",
    "lint": "node tooling/code-style/code-style.mjs --check && node scripts/lint/context-md-prose-unwrap.mjs --check",
    "fmt:imports": "node tooling/code-style/typescript-import-layout.mjs --fix",
    "fmt:objects": "node tooling/code-style/typescript-object-layout.mjs --fix",
    "fmt:parameters": "node tooling/code-style/typescript-parameter-layout.mjs --fix",
    "fmt:consts": "node tooling/code-style/typescript-const-layout.mjs --fix",
    "fmt:css": "node tooling/code-style/css-formatting.mjs --fix",
    "fmt:context-md": "node scripts/lint/context-md-prose-unwrap.mjs --fix",
    "fmt:tooling": "pnpm --dir tooling/code-style fmt",
    "fmt:file": "node tooling/code-style/fmt-file.mjs",
    "fmt": "node tooling/code-style/code-style.mjs --fix && node scripts/lint/context-md-prose-unwrap.mjs --fix",
    "test:code-style": "pnpm --dir tooling/code-style test",
    "test:guidance": "node --test scripts/lint/*.test.mjs .cursor/hooks/*.test.mjs",
    "test:tooling": "pnpm test:code-style && pnpm test:guidance",
    "lint:guidance": "node scripts/lint/guidance.mjs",
    "verify:core": "pnpm lint:baseline && pnpm lint && pnpm typecheck && pnpm test:tooling && pnpm build",
    "verify": "pnpm lint:baseline && pnpm lint && pnpm typecheck && pnpm test:tooling && pnpm lint:guidance && pnpm build"
  }
}
